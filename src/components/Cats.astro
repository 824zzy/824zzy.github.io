<!-- Jack (Orange Tabby, Introvert) - Bottom Left | Luna (Tuxedo, Extrovert) - Bottom Right -->

<div class="cat-wrapper cat-left" id="jack-wrapper" title="Jack 🧡">
  <div class="cat-body jack-anim">
    <img src="/images/jack.png" alt="Jack the orange tabby cat" class="cat-img" draggable="false" />
  </div>
  <div class="cat-speech" id="jack-speech">I'm Jack 🧡</div>
</div>

<div class="cat-wrapper cat-right" id="luna-wrapper" title="Luna 🖤🤍">
  <div class="cat-body luna-anim">
    <img src="/images/luna.png" alt="Luna the tuxedo cat" class="cat-img" draggable="false" />
  </div>
  <div class="cat-speech" id="luna-speech">I'm Luna! 🖤</div>
</div>

<style>
  .cat-wrapper {
    position: fixed;
    bottom: -5px;
    z-index: 50;
    cursor: pointer;
    user-select: none;
  }
  .cat-left { left: 10px; }
  .cat-right { right: 10px; }

  .cat-body {
    position: relative;
    transform-origin: bottom center;
  }

  .cat-img {
    width: 110px;
    height: auto;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.12));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Jack: gentle, shy breathing - small movements */
  .jack-anim {
    animation: jack-idle 4s ease-in-out infinite;
  }
  @keyframes jack-idle {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    30% { transform: translateY(-2px) rotate(-0.5deg); }
    60% { transform: translateY(-3px) rotate(0.3deg); }
  }

  /* Luna: bouncy, energetic idle - bigger movements */
  .luna-anim {
    animation: luna-idle 2.5s ease-in-out infinite;
  }
  @keyframes luna-idle {
    0%, 100% { transform: translateY(0) scale(1) rotate(0deg); }
    25% { transform: translateY(-6px) scale(1.02) rotate(1deg); }
    50% { transform: translateY(-8px) scale(1.03) rotate(0deg); }
    75% { transform: translateY(-5px) scale(1.01) rotate(-1deg); }
  }

  /* Hover: Jack peeks up shyly */
  .cat-left:hover .jack-anim {
    animation: jack-peek 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes jack-peek {
    0% { transform: translateY(0); }
    100% { transform: translateY(-6px) rotate(-2deg); }
  }

  /* Hover: Luna jumps excitedly */
  .cat-right:hover .luna-anim {
    animation: luna-jump 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes luna-jump {
    0% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-18px) scale(1.08) rotate(3deg); }
    100% { transform: translateY(-12px) scale(1.05) rotate(-1deg); }
  }

  /* Click: Jack shrinks shyly */
  .cat-left:active .cat-img {
    transform: scale(0.92) translateY(3px);
  }
  /* Click: Luna bounces big */
  .cat-right:active .cat-img {
    transform: scale(1.12) rotate(5deg);
  }

  /* Speech bubble */
  .cat-speech {
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) translateY(-100%) scale(0);
    background: var(--background, #fff);
    border: 1.5px solid var(--border, #ddd);
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .cat-speech::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid var(--border, #ddd);
  }
  .cat-wrapper:hover .cat-speech {
    opacity: 1;
    transform: translateX(-50%) translateY(-100%) scale(1);
  }

  @media (max-width: 768px) {
    .cat-img { width: 75px; }
  }
  @media (max-width: 480px) {
    .cat-wrapper { display: none; }
  }
</style>

<script is:inline>
  const jackPhrases = ["I'm Jack 🧡", '...hi', '*hides*', '...pet me? 🥺', '*quiet purr*', '...', '*peeks*'];
  const lunaPhrases = ["I'm Luna! 🖤", 'MEOW!', 'HEY HUMAN! 😸', 'PLAY WITH ME! 🐾', '*ZOOMS*', 'LOOK AT ME!', 'TREAT TIME?! 🍗'];
  function setupCat(id, speechId, phrases) {
    const w = document.getElementById(id);
    const s = document.getElementById(speechId);
    if (!w || !s) return;
    w.addEventListener('click', () => {
      s.textContent = phrases[Math.floor(Math.random() * phrases.length)];
    });
  }
  setupCat('jack-wrapper', 'jack-speech', jackPhrases);
  setupCat('luna-wrapper', 'luna-speech', lunaPhrases);
</script>
